{
  "name": "jira-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "AI plugin that checks Jira tickets against a Definition of Ready and refines them",
  "author": "Andres Martinez",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=plugin/dist/server.mjs && node scripts/build-manifests.ts",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "pnpm build && node --test \"test/e2e/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
